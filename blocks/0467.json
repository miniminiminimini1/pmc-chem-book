 of B"},{"x":0.68361,"y":0.87641,"w":0.05826,"h":0.02928,"fs":0.01149,"n":3,"k":1,"t":"1 4 8"},{"x":0.74162,"y":0.87661,"w":0.0366,"h":0.0203,"fs":0.01149,"n":1,"k":1,"t":"RT A"},{"x":0.9034,"y":0.88289,"w":0.04268,"h":0.01527,"fs":0.01277,"n":1,"k":0,"t":"[9.25]"},{"x":0.68121,"y":0.9154,"w":0.01301,"h":0.0294,"fs":0.01149,"n":2,"k":1,"t":"N N"},{"x":0.7183,"y":0.91722,"w":0.01384,"h":0.02763,"fs":0.01149,"n":2,"k":1,"t":"} }"},{"x":0.6635,"y":0.92233,"w":0.0773,"h":0.02359,"fs":0.01149,"n":2,"k":1,"t":"A ="},{"x":0.11598,"y":0.97765,"w":0.76851,"h":0.01618,"fs":0.00639,"n":2,"k":1,"t":"Copyright 2011 Cengage Learning. All Rights Reserved. May not be copied, scanned, or duplicated, in whole or in part. Due to electronic rights, some third party content may be suppressed from the eBook and/or eChapter(s). Editorial review has deemed that any suppressed content does not materially affect the overall learning experience. Cengage Learning reserves the right to remove additional content at any time if subsequent rights restrictions require it."}]}